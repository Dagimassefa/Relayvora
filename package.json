{
  "name": "relayvora-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Local-first continuity and token-efficiency layer for AI coding agents",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "relayvora": "node apps/cli/dist/bin.js",
    "release:pack": "pnpm build && node scripts/package-release.mjs",
    "release:smoke": "node scripts/smoke-release.mjs",
    "bench:plan": "node packages/benchmarks/run.mjs --dry-run"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "typescript": "~5.9.3",
    "vitest": "^3.2.7"
  }
}
